{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eda.local/get/schemas/fascicle-roundtrip.schema.json",
  "title": "GET Autonomous Fascicle Roundtrip Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "package_type",
    "export_profile",
    "export_id",
    "base_revision",
    "project",
    "fascicle",
    "protected_context",
    "editable_knowledge",
    "working_instructions",
    "proposed_removals",
    "change_summary",
    "validation"
  ],
  "properties": {
    "schema_name": {
      "const": "get_fascicle_roundtrip"
    },
    "schema_version": {
      "type": "string"
    },
    "application_version": {
      "type": "string"
    },
    "package_type": {
      "const": "fascicle_roundtrip"
    },
    "export_profile": {
      "enum": [
        "discussion",
        "redaction"
      ]
    },
    "export_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "code",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fascicle": {
      "type": "object",
      "required": [
        "id",
        "display_code",
        "title",
        "revision",
        "scope",
        "structure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "display_code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "string"
        },
        "structure": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "protected_context": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string"
        },
        "knowledge_items": {
          "type": "array",
          "items": {
            "$ref": "knowledge-item.schema.json"
          }
        },
        "terminology": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "editable_knowledge": {
      "type": "object",
      "required": [
        "knowledge_items",
        "decisions",
        "open_questions"
      ],
      "properties": {
        "knowledge_items": {
          "type": "array",
          "items": {
            "$ref": "knowledge-item.schema.json"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "knowledge-item.schema.json"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "knowledge-item.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "technical_instances": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "authoring_profile": {
      "type": "object"
    },
    "working_instructions": {
      "type": "object",
      "required": [
        "preserve_existing_ids",
        "invent_missing_values",
        "treat_omissions_as_deletions",
        "return_complete_package"
      ],
      "properties": {
        "preserve_existing_ids": {
          "const": true
        },
        "invent_missing_values": {
          "const": false
        },
        "treat_omissions_as_deletions": {
          "const": false
        },
        "return_complete_package": {
          "const": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "proposed_removals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "reason"
        ],
        "properties": {
          "target_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "change_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change_type",
          "target_id",
          "summary"
        ],
        "properties": {
          "change_type": {
            "enum": [
              "added",
              "modified",
              "removal_proposed",
              "structure_proposed",
              "unchanged"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "valid_with_warnings",
            "invalid"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
