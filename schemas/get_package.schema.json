{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eda.local/get/schemas/get_package.schema.json",
  "title": "GET Unified Discussion Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "scope",
    "rules",
    "rules_hash",
    "export_id",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "GET-PACKAGE"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "project_id"],
      "properties": {
        "kind": {
          "enum": ["fascicle", "block"]
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "fascicle_id": {
          "type": "string",
          "format": "uuid"
        },
        "block_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fascicle"
              }
            }
          },
          "then": {
            "required": ["fascicle_id"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "block"
              }
            }
          },
          "then": {
            "required": ["block_id"]
          }
        }
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "rules_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "llm_shapes": {
      "type": "object",
      "required": ["version", "scope_kind", "instructions", "collections"],
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string"
        },
        "scope_kind": {
          "enum": ["block", "fascicle"]
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collection_priority": {
          "type": "string"
        },
        "anti_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collections": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "llm_brief": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string"
        },
        "scope_kind": {
          "type": "string"
        },
        "export_id": {
          "type": "string"
        },
        "suggested_prompt": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "fascicle"
              }
            },
            "required": ["kind"]
          }
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://eda.local/get/schemas/fascicle-roundtrip.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "block"
              }
            },
            "required": ["kind"]
          }
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/blockPayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "listTextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "listPromptAnswerItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "answer"],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "pointLists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "development_guidance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "perspectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions_to_answer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listPromptAnswerItem"
          }
        },
        "must_include": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listTextItem"
          }
        },
        "limits_and_exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listTextItem"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listTextItem"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listPromptAnswerItem"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knowledge_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "developmentPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sort_order", "title", "core_idea", "intended_outcome", "lists", "status", "llm_freedom"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sort_order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "core_idea": {
          "type": "string"
        },
        "intended_outcome": {
          "type": "string"
        },
        "lists": {
          "$ref": "#/$defs/pointLists"
        },
        "status": {
          "type": "string"
        },
        "llm_freedom": {
          "type": "string"
        },
        "template_id": {
          "type": ["string", "null"]
        },
        "needs_review": {
          "type": "boolean"
        }
      }
    },
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "importance", "source_type", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string"
        },
        "importance": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "reference_id": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "blockPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "development_points", "premises"],
      "properties": {
        "block": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "display_code", "title", "objective", "scope", "target_output"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "display_code": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "objective": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "target_output": {
              "type": "object"
            }
          }
        },
        "development_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/developmentPoint"
          }
        },
        "premises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/premise"
          }
        }
      }
    }
  }
}