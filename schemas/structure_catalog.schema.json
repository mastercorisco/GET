{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eda.local/get/schemas/structure_catalog.schema.json",
  "title": "GET Structure Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "locale", "fascicles", "totals"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "source": { "type": "string" },
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "display_name": { "type": "string" },
    "complements": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "fascicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "ordinal", "title", "blocks"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "ordinal": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "ordinal", "title"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "ordinal": { "type": "integer", "minimum": 1 },
                "title": { "type": "string", "minLength": 1 },
                "development_points": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      {
                        "type": "object",
                        "required": ["text"],
                        "properties": { "text": { "type": "string", "minLength": 1 } }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fascicles", "blocks"],
      "properties": {
        "fascicles": { "type": "integer", "minimum": 1 },
        "blocks": { "type": "integer", "minimum": 0 },
        "development_points": { "type": "integer", "minimum": 0 }
      }
    }
  }
}